<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gnt_outline_shape"
        android:padding="12dp">

        <!-- 1. MediaView: Top position, supports ALL videos and images from Google AdMob -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- 2. Middle Info Row: App Icon + Headline / Rating / Advertiser -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- App Icon -->
            <ImageView
                android:id="@+id/icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_native_ad_icon"
                android:clipToOutline="true"
                android:layout_marginEnd="10dp" />

            <!-- Content Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Top Row: Ad indicator + RatingBar + Secondary -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:id="@+id/ad_notification_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ad"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFB800"
                        android:background="@drawable/gnt_rounded_corners_shape"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginEnd="6dp" />

                    <RatingBar
                        android:id="@+id/rating_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:isIndicator="true"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/gnt_gray"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Headline -->
                <TextView
                    android:id="@+id/primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gnt_white"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Body description -->
        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gnt_gray"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- 4. Call to Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_native_ad_button"
            android:textColor="@color/gnt_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:stateListAnimator="@null" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
